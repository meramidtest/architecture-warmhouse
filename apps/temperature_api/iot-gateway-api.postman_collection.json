{
  "info": {
    "_postman_id": "a1b2c3d4-5678-90ab-cdef-1234567890ab",
    "name": "IoT Gateway API",
    "description": "A collection for testing the IoT Gateway Temperature and Sensor Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Temperature API",
      "item": [
        {
          "name": "Get Temperature by Location",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/temperature?location=Kitchen",
              "host": ["{{baseUrl}}"],
              "path": ["temperature"],
              "query": [
                {
                  "key": "location",
                  "value": "Kitchen"
                }
              ]
            },
            "description": "Get temperature data for a specific location"
          },
          "response": []
        },
        {
          "name": "Get Temperature by Sensor ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/temperature/temp002",
              "host": ["{{baseUrl}}"],
              "path": ["temperature", "temp002"]
            },
            "description": "Get temperature data for a specific sensor ID"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Sensor Management API",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Check if the API is running"
          },
          "response": []
        },
        {
          "name": "Get All Sensors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sensors",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sensors"]
            },
            "description": "Retrieve all sensors"
          },
          "response": []
        },
        {
          "name": "Get Sensor by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sensors/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sensors", "1"]
            },
            "description": "Retrieve a specific sensor by database ID"
          },
          "response": []
        },
        {
          "name": "Create Sensor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Garden Temperature\",\n    \"type\": \"temperature\",\n    \"location\": \"Garden\",\n    \"unit\": \"°C\",\n    \"sensor_id\": \"temp009\",\n    \"sensor_type\": \"DHT22\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sensors",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sensors"]
            },
            "description": "Create a new sensor"
          },
          "response": []
        },
        {
          "name": "Update Sensor",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Updated Garden Temperature\",\n    \"type\": \"temperature\",\n    \"location\": \"Garden\",\n    \"unit\": \"°F\",\n    \"status\": \"maintenance\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sensors/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sensors", "1"]
            },
            "description": "Update an existing sensor"
          },
          "response": []
        },
        {
          "name": "Delete Sensor",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sensors/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sensors", "1"]
            },
            "description": "Delete a sensor"
          },
          "response": []
        },
        {
          "name": "Update Sensor Value",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"value\": 25.8,\n    \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sensors/1/value",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sensors", "1", "value"]
            },
            "description": "Update a sensor's value and status"
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ]
} 